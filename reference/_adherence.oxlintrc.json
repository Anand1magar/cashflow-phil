{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/cash-flow/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lato))/i]",
        "message": "Font not provided by the design system. Available: Lato."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|className|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, onChange, disabled, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderAndStatusbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|onBack|showBack|className|style|key|ref|className|style|children)$/]",
        "message": "<HeaderAndStatusbar> doesn't accept that prop. Declared props: progress, onBack, showBack, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|className|style|key|ref|className|style|children)$/]",
        "message": "<InfoMessage> doesn't accept that prop. Declared props: icon, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|state|helper|rightIcon|type|className|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, placeholder, state, helper, rightIcon, type, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|focused|filled|error|disabled)$/]",
        "message": "<Input> state must be one of 'default' | 'focused' | 'filled' | 'error' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MyPhil24PlusSm'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<MyPhil24PlusSm> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MyPhilButtonExtended'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|showLabel|buttonLabel|device|showRightIcon|iconRight|hirerarchy|iconLeft|showLeftIcon|state|key|ref|className|style|children)$/]",
        "message": "<MyPhilButtonExtended> doesn't accept that prop. Declared props: className, style, showLabel, buttonLabel, device, showRightIcon, iconRight, hirerarchy, iconLeft, showLeftIcon, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='MyPhilButtonExtended'] > JSXAttribute[name.name='device'] > Literal[value!=/^(?:desktop|mobile)$/]",
        "message": "<MyPhilButtonExtended> device must be one of 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MyPhilButtonExtended'] > JSXAttribute[name.name='hirerarchy'] > Literal[value!=/^(?:primary|secondary|tertiary|link)$/]",
        "message": "<MyPhilButtonExtended> hirerarchy must be one of 'primary' | 'secondary' | 'tertiary' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MyPhilButtonExtended'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:hover|default|clicked|disabled)$/]",
        "message": "<MyPhilButtonExtended> state must be one of 'hover' | 'default' | 'clicked' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MyPhilFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<MyPhilFooter> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButtonChecked'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|style2|key|ref|className|style|children)$/]",
        "message": "<RadioButtonChecked> doesn't accept that prop. Declared props: className, style, style2."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButtonChecked'] > JSXAttribute[name.name='style2'] > Literal[value!=/^(?:filled|outlined|round|sharp|two tone)$/]",
        "message": "<RadioButtonChecked> style2 must be one of 'filled' | 'outlined' | 'round' | 'sharp' | 'two tone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButtons'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|supportingText|device|borderless|selected|text|state|text1|text2|icon1|key|ref|className|style|children)$/]",
        "message": "<RadioButtons> doesn't accept that prop. Declared props: className, style, supportingText, device, borderless, selected, text, state, text1, text2, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButtons'] > JSXAttribute[name.name='device'] > Literal[value!=/^(?:mobile|desktop)$/]",
        "message": "<RadioButtons> device must be one of 'mobile' | 'desktop'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButtons'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:enabled|hovered|focused|pressed|disabled)$/]",
        "message": "<RadioButtons> state must be one of 'enabled' | 'hovered' | 'focused' | 'pressed' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButtonUnchecked'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|style2|key|ref|className|style|children)$/]",
        "message": "<RadioButtonUnchecked> doesn't accept that prop. Declared props: className, style, style2."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButtonUnchecked'] > JSXAttribute[name.name='style2'] > Literal[value!=/^(?:filled|outlined|round|sharp|two tone)$/]",
        "message": "<RadioButtonUnchecked> style2 must be one of 'filled' | 'outlined' | 'round' | 'sharp' | 'two tone'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
